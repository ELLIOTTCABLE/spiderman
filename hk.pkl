amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"

default_branch = "ai/main"

// staged paths only (~3 s budget); full lint + typecheck is `mise run gate`
local linters = new Mapping<String, Step> {
   ["biome"] {
      glob = List("*.ts", "*.js", "*.mjs", "*.json", "*.jsonc")
      check = "biome check --error-on-warnings --no-errors-on-unmatched {{files}}"
      fix = "biome check --write --no-errors-on-unmatched {{files}}"
   }
}

hooks {
   // never rewrite the tree under a running agent; stash stack is shared across worktrees
   ["pre-commit"] {
      fix = false
      stash = "none"
      steps = linters
   }
   ["fix"] {
      fix = true
      steps = linters
   }
   ["check"] {
      steps = linters
   }
}
